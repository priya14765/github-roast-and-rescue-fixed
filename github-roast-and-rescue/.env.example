# Copy to .env for local use, or set these on Cloud Run. Never commit real values.
# Optional: raises the GitHub limit from 60 to 5,000 requests/hour and enables pinned repositories.
GITHUB_TOKEN=
# Optional: enables Gemini wording polish. Without it the app uses its built-in templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CACHE_TTL_SECONDS=3600
MAX_REPOS=6
RATE_LIMIT_PER_MINUTE=10
